# Postgres connection string (Neon, Supabase, or local Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/cronwatch"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"

# Base URL of your deployed app (used to build ping URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: outbound webhook alerting (Slack/Discord incoming webhook URL)
# Individual jobs store their own alert webhook, this is just a fallback/example
